# Copy to `.env` (in "Agentic AI/" for all projects, or in one project folder) and fill in only what you have.
# Nothing is required: with no keys, every project runs offline on a local open-weight model.
# Never commit `.env`; it is git-ignored.

# ---------- Provider selection ----------
# auto (default): OpenAI key -> Gemini key -> running Ollama server -> local Hugging Face model
LLM_PROVIDER=auto
# Optional: force a model for whichever provider is selected
LLM_MODEL=

# ---------- OpenAI (or any OpenAI-compatible server: vLLM, LM Studio, Azure proxy ...) ----------
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_BASE_URL=

# ---------- Google Gemini ----------
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# ---------- Ollama (local server) ----------
OLLAMA_HOST=http://localhost:11434
# Empty = best installed model (qwen3 preferred)
OLLAMA_MODEL=

# ---------- Local Hugging Face model (offline default) ----------
# Empty = best Apache-2.0 Qwen3 model that fits in free memory: Qwen3-8B / 4B / 1.7B / 0.6B
HF_MODEL=
# Optional: raises download rate limits
HF_TOKEN=

# ---------- Behaviour ----------
# off (default: every call is live) | readwrite (reuse and store; replays are labelled) | replay (cache only, for exact reproduction)
LLM_CACHE=off
# local (default): if an API provider fails, fall back to the local model, logged and labelled | none: raise the error
LLM_FALLBACK=local
# Same-provider models tried (in order) before the local fallback, e.g. when a model is overloaded.
# Empty = defaults (gemini: gemini-flash-lite-latest, gemini-3.1-flash-lite; openai: gpt-4.1-nano, gpt-4o-mini)
LLM_FALLBACK_MODELS=
LLM_MAX_RETRIES=4
# Seconds between API calls; e.g. 4 keeps a free-tier Gemini key under ~15 requests/minute (0 = no pacing)
LLM_MIN_INTERVAL=0
LLM_TIMEOUT=120
LLM_SEED=0
# Optional cost estimates for models not in agentkit's price table (USD per 1M tokens)
LLM_PRICE_INPUT_PER_M=
LLM_PRICE_OUTPUT_PER_M=
